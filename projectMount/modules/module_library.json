    {
      "id": "mod_cabinet_001",
      "name": "床头柜",
      "tags": [
        "sleep"
      ],
      "size": {
        "width": 450,
        "depth": 400
      },
      "agent_config": {
        "morphology": {
          "strategy": "fixed"
        },
        "topology_rules": [
          "必须紧贴床头两侧",
          "【必须】facing 方向与所依附的床一致（背靠同一面墙，正面朝房间）"
        ],
        "relation_rules": [
          "【必须】卧室默认先布置两个床头柜；仅当 1500 床 + 双床头柜仍不成立时，才允许保留一个。单柜时优先保留远离窗户侧；仅当该侧存在不可解决的物理冲突时，才回退为保留窗侧",
          "【建议】所有卧室优先成对布置（对称布局）；空间不足时先换更小床，再考虑单柜。",
          "【提示】床头柜与相邻家具（如衣柜）之间的间隙是使用间隙，不适用通道宽度标准；相邻衣柜空间不足时应选用移门"
        ]
      },
      "description": "凤栖湖450床头柜",
      "svgPath": "assets/mod_cabinet_001.svg"
    },
    {
      "id": "mod_cabinet_custom_001",
